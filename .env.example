# Database: set automatically by Vercel's Neon (Postgres) integration
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Passwords: choose long random values
ADMIN_TOKEN=            # sign-in for /admin.html
GOOGLE_LEADS_KEY=       # same value as the key in the Google Ads lead form webhook
CRON_SECRET=            # Vercel sends this to the hourly listing sync

# Listing feeds
DDF_CLIENT_ID=          # CREA DDF credentials
DDF_CLIENT_SECRET=
CREA_DESTINATION_ID=    # CREA analytics destination id (rule 5(c)); leave empty until CREA provides it
PROPTX_TOKEN=           # leave empty until the brokerage's PropTx agreement is approved

# Realtor alerts
RESEND_API_KEY=         # email via resend.com
NOTIFY_FROM_EMAIL=      # e.g. leads@yourdomain.ca (domain verified in Resend)
TWILIO_ACCOUNT_SID=     # SMS via twilio.com
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=     # e.g. +14165550100
APP_URL=                # e.g. https://leads.icloudrealty.ca, used for links in alerts

# Optional
LEAD_ROUTING=owner      # owner (default): every lead goes to the feed owner; area: split by area
OWNER_SELLER_ID=        # which seller is the feed owner; default is the first active seller
ALLOWED_ORIGINS=        # sites allowed to post leads, comma separated; empty = any
APP_TIMEZONE=America/Toronto
LISTINGS_RATE_LIMIT=120 # listing searches per IP per minute
